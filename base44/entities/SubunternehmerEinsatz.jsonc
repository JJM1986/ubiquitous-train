{
  "name": "SubunternehmerEinsatz",
  "type": "object",
  "properties": {
    "subcontractor_id": {
      "type": "string",
      "title": "Subunternehmer"
    },
    "subcontractor_name": {
      "type": "string",
      "title": "Subunternehmername"
    },
    "project_id": {
      "type": "string",
      "title": "Projekt"
    },
    "project_name": {
      "type": "string",
      "title": "Projektname"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Datum"
    },
    "task": {
      "type": "string",
      "title": "Leistung"
    },
    "hours": {
      "type": "number",
      "title": "Stunden"
    },
    "cost": {
      "type": "number",
      "title": "Kosten (\u20ac)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Geplant",
        "In Arbeit",
        "Abgeschlossen"
      ],
      "default": "Geplant",
      "title": "Status"
    },
    "notes": {
      "type": "string",
      "title": "Notizen"
    }
  },
  "required": [
    "subcontractor_id",
    "project_id",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "bauleiter"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "bauleiter"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "bauleiter"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}