{
  "name": "Stundenkonto",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Projekt"
    },
    "project_name": {
      "type": "string",
      "title": "Projektbezeichnung"
    },
    "planned_hours": {
      "type": "number",
      "title": "Geplante Stunden"
    },
    "actual_hours_override": {
      "type": "number",
      "title": "Tats\u00e4chliche Stunden (manuell)"
    },
    "period": {
      "type": "string",
      "title": "Zeitraum",
      "default": "Gesamt"
    },
    "notes": {
      "type": "string",
      "title": "Notizen"
    }
  },
  "required": [
    "project_id",
    "planned_hours"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "bauleiter"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "bauleiter"
          }
        },
        {
          "user_condition": {
            "role": "monteur"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "bauleiter"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}